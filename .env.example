# =========================================================
# Smart Parking Violation Detection - Configuration Template
# =========================================================
# Copy this file to '.env' and populate your test credentials.
# Never commit real credentials or .env to version control.

# SMTP Email Dispatch Settings (Gmail)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Parking Facility Location Label
CONFIGURED_LOCATION=Main Campus Parking Area

# Local/demo access only. For a deployment, put the app behind an identity-aware
# reverse proxy or configure an organization-approved identity provider.
APP_PASSWORD=
AUTH_IDLE_TIMEOUT_MINUTES=30

# Upload guardrails (maxUploadSize in .streamlit/config.toml must match MAX_IMAGE_UPLOAD_MB).
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_PIXELS=40000000

# Model & Storage Paths (Optional Overrides)
# VEHICLE_MODEL_PATH=models/yolov8n.pt
# OVERHEAD_VEHICLE_MODEL_PATH=models/yolov8n_visdrone.pt
# OFFSED_SURFACE_MODEL_PATH=models/offsed_surface_segformer
# BDD100K_SIDEWALK_MODEL_PATH=models/bdd100k_sidewalk_segformer
